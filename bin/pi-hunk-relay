#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &&
    pwd
)"

PI_HOME="$(
  cd -- "$SCRIPT_DIR/.." &&
    pwd
)"

RELAY_SCRIPT="$PI_HOME/bin/tcp-relay.mjs"

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/pi-hunk-relay-${UID}"
PID_FILE="$STATE_DIR/relay.pid"
LOG_FILE="$STATE_DIR/relay.log"
LOCK_DIR="$STATE_DIR/lock"

HOST_BIND="${HUNK_HOST_RELAY_BIND:-0.0.0.0}"
HOST_PORT="${HUNK_HOST_RELAY_PORT:-47658}"

HUNK_HOST="127.0.0.1"
HUNK_PORT="47657"

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

relay_health() {
  curl -fsS \
    --connect-timeout 1 \
    --max-time 2 \
    -H "Host: 127.0.0.1:47657" \
    "http://127.0.0.1:${HOST_PORT}/health" \
    >/dev/null 2>&1
}

hunk_health() {
  curl -fsS \
    --connect-timeout 1 \
    --max-time 2 \
    "http://${HUNK_HOST}:${HUNK_PORT}/health" \
    >/dev/null 2>&1
}

read_pid() {
  if [[ -s "$PID_FILE" ]]; then
    cat "$PID_FILE"
  fi
}

acquire_lock() {
  local attempt

  for attempt in $(seq 1 50); do
    if mkdir "$LOCK_DIR" 2>/dev/null; then
      return 0
    fi

    sleep 0.1
  done

  echo "Could not acquire Hunk relay lock." >&2
  return 1
}

release_lock() {
  rmdir "$LOCK_DIR" 2>/dev/null || true
}

start_relay() {
  if relay_health; then
    echo "Hunk host relay is already running on port ${HOST_PORT}."
    return 0
  fi

  acquire_lock
  trap release_lock RETURN

  # Another process may have started it while we waited.
  if relay_health; then
    echo "Hunk host relay is already running on port ${HOST_PORT}."
    return 0
  fi

  if ! hunk_health; then
    echo "The Hunk daemon is not available at:" >&2
    echo "  http://${HUNK_HOST}:${HUNK_PORT}/health" >&2
    echo >&2
    echo "Open a Hunk session before running pi." >&2
    return 1
  fi

  if [[ ! -f "$RELAY_SCRIPT" ]]; then
    echo "Relay script not found:" >&2
    echo "  $RELAY_SCRIPT" >&2
    return 1
  fi

  local existing_pid
  existing_pid="$(read_pid || true)"

  if [[ -n "$existing_pid" ]] &&
     kill -0 "$existing_pid" 2>/dev/null
  then
    echo "A managed relay process exists but is unhealthy." >&2
    echo "PID: $existing_pid" >&2
    echo "Log: $LOG_FILE" >&2
    return 1
  fi

  rm -f "$PID_FILE"
  : >"$LOG_FILE"

  nohup env \
    LISTEN_HOST="$HOST_BIND" \
    LISTEN_PORT="$HOST_PORT" \
    TARGET_HOST="$HUNK_HOST" \
    TARGET_PORT="$HUNK_PORT" \
    node "$RELAY_SCRIPT" \
    </dev/null \
    >"$LOG_FILE" 2>&1 &

  local relay_pid=$!
  printf '%s\n' "$relay_pid" >"$PID_FILE"
  chmod 600 "$PID_FILE"

  local attempt

  for attempt in $(seq 1 50); do
    if relay_health; then
      echo "Hunk host relay started."
      echo "PID:  $relay_pid"
      echo "Route: ${HOST_BIND}:${HOST_PORT} -> ${HUNK_HOST}:${HUNK_PORT}"
      return 0
    fi

    if ! kill -0 "$relay_pid" 2>/dev/null; then
      break
    fi

    sleep 0.1
  done

  echo "Hunk host relay failed to start." >&2

  if [[ -s "$LOG_FILE" ]]; then
    cat "$LOG_FILE" >&2
  fi

  kill "$relay_pid" 2>/dev/null || true
  rm -f "$PID_FILE"

  return 1
}

stop_relay() {
  local relay_pid
  relay_pid="$(read_pid || true)"

  if [[ -z "$relay_pid" ]]; then
    if relay_health; then
      echo "A relay is running on port ${HOST_PORT}," >&2
      echo "but it is not managed by this command." >&2
      return 1
    fi

    echo "Hunk host relay is not running."
    return 0
  fi

  if kill -0 "$relay_pid" 2>/dev/null; then
    kill "$relay_pid"

    local attempt

    for attempt in $(seq 1 30); do
      if ! kill -0 "$relay_pid" 2>/dev/null; then
        break
      fi

      sleep 0.1
    done

    if kill -0 "$relay_pid" 2>/dev/null; then
      echo "Relay did not stop cleanly. PID: $relay_pid" >&2
      return 1
    fi
  fi

  rm -f "$PID_FILE"

  echo "Hunk host relay stopped."
}

show_status() {
  if relay_health; then
    local relay_pid
    relay_pid="$(read_pid || true)"

    echo "Hunk host relay is healthy."
    echo "Port: $HOST_PORT"

    if [[ -n "$relay_pid" ]]; then
      echo "PID:  $relay_pid"
    else
      echo "PID:  unmanaged"
    fi

    return 0
  fi

  echo "Hunk host relay is not available."
  return 1
}

show_log() {
  if [[ -f "$LOG_FILE" ]]; then
    cat "$LOG_FILE"
  else
    echo "No relay log exists."
  fi
}

command="${1:-status}"

case "$command" in
  start | ensure) start_relay ;;

  stop) stop_relay ;;

  restart)
    stop_relay
    start_relay
    ;;

  status) show_status ;;

  log | logs) show_log ;;

  *)
    echo "Usage: pi-hunk-relay {start|ensure|stop|restart|status|log}" >&2
    exit 2
    ;;
esac
